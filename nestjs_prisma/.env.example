# ============================================
# Database - PostgreSQL
# ============================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nest_auth?schema=public"
DATABASE_PORT=5432

# ============================================
# Redis
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# JWT - Access & Refresh Tokens
# NOTE: JWT_SECRET is legacy, kept for backward compat with auth module.
# T-0006 will migrate auth module to use JWT_ACCESS_TOKEN_* and JWT_REFRESH_TOKEN_*.
# ============================================
JWT_SECRET="change-me-in-production"
JWT_ACCESS_TOKEN_SECRET="change-me-in-production-access"
JWT_ACCESS_TOKEN_EXPIRATION=7d
JWT_REFRESH_TOKEN_SECRET="change-me-in-production-refresh"
JWT_REFRESH_TOKEN_EXPIRATION=30d

# ============================================
# API
# ============================================
API_PREFIX=api/v1
API_PORT=3000

# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
CORS_CREDENTIALS=true

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ============================================
# Google Maps API - Routes Service (T-0031)
# DEPRECATED: replaced by Goong (T-0050). Removal handled in T-0056.
# ============================================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_MAPS_BASE_URL=https://maps.googleapis.com/maps/api

# ============================================
# Goong API - Routes Service (T-0050, replaces Google Maps)
# ============================================
GOONG_API_KEY=your_goong_api_key_here
GOONG_BASE_URL=https://rsapi.goong.io

# ============================================
# VNPay Payment Gateway (T-0062, T-0075)
# Register a sandbox merchant at https://sandbox.vnpayment.vn/devreg to obtain
# TMN_CODE and HASH_SECRET. Paste them into your local .env (never commit real values).
# VNPAY_RETURN_URL must be reachable by VNPay's servers: use your LAN IP for
# emulator/device access, or an ngrok/tunnel host for a hosted callback.
# ============================================
VNPAY_TMN_CODE=your_tmncode_here
VNPAY_HASH_SECRET=your_hash_secret_here
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://<LAN_OR_TUNNEL_HOST>:3000/api/v1/payments/vnpay/callback
